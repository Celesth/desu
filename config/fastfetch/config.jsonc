{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "key": "Hostname",
            "format": "{host-name}"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
