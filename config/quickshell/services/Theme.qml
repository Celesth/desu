pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Single source of truth for the palette generated by Matugen.
Singleton {
    id: root

    property color background: "#202020"
    property color surface: "#292929"
    property color elevated: "#333333"
    property color border: "#555555"
    property color text: "#E6E6E6"
    property color textSecondary: "#B8B8B8"
    property color textMuted: "#858585"
    property color selection: "#3A3A3A"
    property color accent: "#D0D0D0"
    property color accentText: "#202020"
    property color errorColor: "#FFB4AB"

    property string name: "MATUGEN"
    readonly property string palettePath: Settings.cacheHome + "/desu/matugen/colors.json"

    readonly property int borderWidth: 1
    readonly property int gap: 2

    function load(value) {
        try {
            const palette = JSON.parse(value);
            name = palette.name || "MATUGEN";
            background = palette.background || background;
            surface = palette.surface || surface;
            elevated = palette.elevated || elevated;
            border = palette.border || border;
            text = palette.text || text;
            textSecondary = palette.textSecondary || textSecondary;
            textMuted = palette.textMuted || textMuted;
            selection = palette.selection || selection;
            accent = palette.accent || accent;
            accentText = palette.accentText || accentText;
            errorColor = palette.errorColor || errorColor;
        } catch (parseError) {
            Desktop.notify("matugen palette could not be loaded", true);
        }
    }

    FileView {
        id: paletteFile
        path: root.palettePath
        watchChanges: true
        printErrors: false
        onLoaded: load(text())
        onFileChanged: reload()
    }
}
